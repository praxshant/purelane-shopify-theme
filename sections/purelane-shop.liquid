{%- assign selected_collection = section.settings.collection | default: collections.all -%}

<section class="sec purelane-shop" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      <div class="rule" aria-hidden="true"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div>
    </div>
    <div class="shelf" role="list">
      {% for product in selected_collection.products limit: section.settings.products_to_show %}
        {% render 'purelane-product-card', product: product, section: section %}
      {% else %}
        <p class="lede">{{ section.settings.empty_message | escape }}</p>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane shop",
  "tag": "section",
  "class": "purelane-shop-section",
  "settings": [
    {"type":"text","id":"kicker","label":"Kicker","default":"Bestsellers"},
    {"type":"text","id":"heading","label":"Heading","default":"Loved by 30,000 homes"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"products_to_show","label":"Products to show","min":4,"max":16,"step":1,"default":8},
    {"type":"text","id":"empty_message","label":"Empty collection message","default":"Add products to the selected collection to populate this section."}
  ],
  "presets": [{"name":"Purelane shop"}]
}
{% endschema %}
