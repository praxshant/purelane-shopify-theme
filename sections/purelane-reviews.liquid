<section class="sec revband purelane-reviews" id="reviews" data-scene="1"><div class="wrap"><div class="revhead rv"><span class="kicker">{{ section.settings.kicker | escape }}</span><span class="agg"><span class="st" aria-hidden="true">★★★★★</span> <b>{{ section.settings.rating | escape }}</b> {{ section.settings.rating_text | escape }}</span><span class="agg">{{ section.settings.homes_text | escape }}</span></div></div><div class="revrail rv" aria-label="Customer reviews"><div class="revtrack">
{% for block in section.blocks %}<article class="glass-2 rcard" {{ block.shopify_attributes }}><div class="st" aria-label="5 out of 5 stars">★★★★★</div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.quote | escape }}</p><div class="who">{% render 'purelane-check-icon' %}<b>{{ block.settings.name | escape }}</b><span>· {{ block.settings.product | escape }}</span></div></article>{% endfor %}
{% for block in section.blocks %}<article class="glass-2 rcard" aria-hidden="true"><div class="st">★★★★★</div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.quote | escape }}</p><div class="who"><b>{{ block.settings.name | escape }}</b><span>· {{ block.settings.product | escape }}</span></div></article>{% endfor %}
</div></div></section>
{% schema %}
{"name":"Purelane reviews","tag":"section","class":"purelane-reviews-section","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"That's what they said"},{"type":"text","id":"rating","label":"Rating","default":"4.8"},{"type":"text","id":"rating_text","label":"Rating text","default":"from 8,000+ reviews"},{"type":"text","id":"homes_text","label":"Homes text","default":"Loved by 12 lakh+ homes"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"text","id":"title","label":"Title","default":"Works like a charm"},{"type":"textarea","id":"quote","label":"Review","default":"Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."},{"type":"text","id":"name","label":"Name","default":"Verified buyer"},{"type":"text","id":"product","label":"Product","default":"Kitchen cleaner"}]}],"presets":[{"name":"Purelane reviews","blocks":[{"type":"review","settings":{"title":"Works like a charm","name":"Anita","product":"Laundry detergent"}},{"type":"review","settings":{"title":"Best dishwash ever","name":"Priya","product":"Dishwash gel"}},{"type":"review","settings":{"title":"Great product, great packaging","name":"Sunita","product":"Liquid handwash"}},{"type":"review","settings":{"title":"Dog friendly","name":"Rohit S.","product":"Floor cleaner"}},{"type":"review","settings":{"title":"Sparkling taps again","name":"Verified buyer","product":"Tap cleaner"}}]}]}
{% endschema %}
