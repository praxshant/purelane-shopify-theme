<section class="sec purelane-bundles" id="bundles" data-scene="3"><div class="wrap"><div class="glass sec-pad rv" style="margin-bottom:16px"><div class="panel-head" style="margin-bottom:0"><span class="kicker">{{ section.settings.kicker | escape }}</span><h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2><p class="lede" style="margin:0 auto">{{ section.settings.subheading | escape }}</p></div></div><div class="tiers" role="list">
{% for block in section.blocks %}<article class="glass tier{% if block.settings.featured %} best{% endif %} rv" role="listitem" {{ block.shopify_attributes }}><span class="tag">{{ block.settings.tag | escape }}</span><div class="tierpix{% if block.settings.products.size > 4 %} five{% endif %}" aria-hidden="true">{% for product in block.settings.products limit: 5 %}{% if product.featured_image %}{{ product.featured_image | image_url: width: 180 | image_tag: class: 'shop-pimg', loading: 'lazy', alt: product.title }}{% endif %}{% endfor %}</div><div class="qty">{{ block.settings.qty | escape }}<small>Products</small></div><div class="price">{{ block.settings.price | escape }}{% if block.settings.compare_at != blank %} <s>{{ block.settings.compare_at | escape }}</s>{% endif %}</div><p class="body-s" style="font-size:12px">{{ block.settings.price_note | escape }}</p><ul>{% if block.settings.feature_one != blank %}<li>{% render 'purelane-check-icon' %}{{ block.settings.feature_one | escape }}</li>{% endif %}{% if block.settings.feature_two != blank %}<li>{% render 'purelane-check-icon' %}{{ block.settings.feature_two | escape }}</li>{% endif %}{% if block.settings.feature_three != blank %}<li>{% render 'purelane-check-icon' %}{{ block.settings.feature_three | escape }}</li>{% endif %}</ul><a class="btn {% if block.settings.featured %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#shop' }}">{{ block.settings.button_label | escape }}</a></article>{% endfor %}
</div></div></section>
{% schema %}
{"name":"Purelane bundles","tag":"section","class":"purelane-bundles-section","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"Build your bundle"},{"type":"text","id":"heading","label":"Heading","default":"One box. Every room."},{"type":"textarea","id":"subheading","label":"Subheading","default":"Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."}],"blocks":[{"type":"bundle","name":"Bundle tier","settings":[{"type":"text","id":"tag","label":"Tag","default":"Starter"},{"type":"product_list","id":"products","label":"Included products (visual stack)","limit":5},{"type":"text","id":"qty","label":"Product count","default":"2"},{"type":"header","content":"Offer pricing"},{"type":"text","id":"price","label":"Price","default":"₹349","info":"Flat bundle offer price. No native single-product field exists for a build-your-bundle tier, so this is an editable value."},{"type":"text","id":"compare_at","label":"Compare-at price","default":"₹598"},{"type":"text","id":"price_note","label":"Price note","default":"Flat ₹174 per product"},{"type":"header","content":"Features"},{"type":"text","id":"feature_one","label":"Feature one","default":"Pick any two products"},{"type":"text","id":"feature_two","label":"Feature two","default":"Free shipping across India"},{"type":"text","id":"feature_three","label":"Feature three"},{"type":"header","content":"Call to action"},{"type":"text","id":"button_label","label":"Button label","default":"Build this box"},{"type":"text","id":"button_link","label":"Button link","default":"#shop","info":"On-page anchor (e.g. #shop) or a URL."},{"type":"checkbox","id":"featured","label":"Featured","default":false}]}],"presets":[{"name":"Purelane bundles","blocks":[{"type":"bundle","settings":{"tag":"Starter"}},{"type":"bundle","settings":{"tag":"Most popular","featured":true}},{"type":"bundle","settings":{"tag":"Whole home"}}]}]}
{% endschema %}
