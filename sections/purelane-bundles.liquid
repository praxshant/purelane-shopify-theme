<section class="sec purelane-bundles" id="bundles" data-scene="3"><div class="wrap"><div class="glass sec-pad rv" style="margin-bottom:16px"><div class="panel-head" style="margin-bottom:0"><span class="kicker">{{ section.settings.kicker | escape }}</span><h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2><p class="lede" style="margin:0 auto">{{ section.settings.subheading | escape }}</p></div></div><div class="tiers" role="list">
{% for block in section.blocks %}{%- assign bundle_product = block.settings.bundle_product -%}{%- assign bundle_variant = bundle_product.selected_or_first_available_variant -%}<article class="glass tier{% if block.settings.featured %} best{% endif %} rv" role="listitem" {{ block.shopify_attributes }}><span class="tag">{{ block.settings.tag | escape }}</span><div class="tierpix{% if block.settings.products.size > 4 %} five{% endif %}" aria-hidden="true">{% for product in block.settings.products limit: 5 %}{% if product.featured_image %}{{ product.featured_image | image_url: width: 180 | image_tag: class: 'shop-pimg', loading: 'lazy', alt: product.title }}{% endif %}{% endfor %}</div><div class="qty">{{ block.settings.products.size }}<small>Products</small></div>{% if bundle_product != blank %}<div class="price">{{ bundle_variant.price | money }}{% if bundle_variant.compare_at_price > bundle_variant.price %} <s>{{ bundle_variant.compare_at_price | money }}</s>{% endif %}</div>{% endif %}<p class="body-s" style="font-size:12px">{{ block.settings.price_note | escape }}</p><ul>{% if block.settings.feature_one != blank %}<li>{% render 'purelane-check-icon' %}{{ block.settings.feature_one | escape }}</li>{% endif %}{% if block.settings.feature_two != blank %}<li>{% render 'purelane-check-icon' %}{{ block.settings.feature_two | escape }}</li>{% endif %}{% if block.settings.feature_three != blank %}<li>{% render 'purelane-check-icon' %}{{ block.settings.feature_three | escape }}</li>{% endif %}</ul>{% if bundle_product != blank %}{% form 'product', bundle_product, class: 'purelane-bundle-form' %}<input type="hidden" name="id" value="{{ bundle_variant.id }}"><button type="submit" class="btn {% if block.settings.featured %}btn-primary{% else %}btn-ghost{% endif %}" {% if bundle_product.available == false %}disabled{% endif %}>{% if bundle_product.available == false %}Unavailable{% else %}{{ block.settings.button_label | escape }}{% endif %}</button>{% endform %}{% else %}<button type="button" class="btn btn-ghost" disabled>Select a bundle product</button>{% endif %}</article>{% endfor %}
</div></div></section>
{% schema %}
{"name":"Purelane bundles","tag":"section","class":"purelane-bundles-section","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"Build your bundle"},{"type":"text","id":"heading","label":"Heading","default":"One box. Every room."},{"type":"textarea","id":"subheading","label":"Subheading","default":"Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."}],"blocks":[{"type":"bundle","name":"Bundle tier","settings":[{"type":"text","id":"tag","label":"Tag","default":"Starter"},{"type":"product","id":"bundle_product","label":"Bundle product","info":"Select the real Shopify bundle product. Its price, compare-at price, availability, and cart item are used by this card."},{"type":"product_list","id":"products","label":"Included products","limit":5},{"type":"text","id":"price_note","label":"Price note","default":"Add selected products to your cart"},{"type":"text","id":"feature_one","label":"Feature one","default":"Pick products for your home"},{"type":"text","id":"feature_two","label":"Feature two","default":"Free shipping across India"},{"type":"text","id":"feature_three","label":"Feature three"},{"type":"text","id":"button_label","label":"Button label","default":"Add bundle to cart"},{"type":"checkbox","id":"featured","label":"Featured","default":false}]}],"presets":[{"name":"Purelane bundles","blocks":[{"type":"bundle","settings":{"tag":"Starter"}},{"type":"bundle","settings":{"tag":"Most popular","featured":true}},{"type":"bundle","settings":{"tag":"Whole home"}}]}]}
{% endschema %}
