<section class="sec purelane-bundles" id="bundles" data-scene="3"><div class="wrap"><div class="glass sec-pad rv" style="margin-bottom:16px"><div class="panel-head" style="margin-bottom:0"><span class="kicker">{{ section.settings.kicker | escape }}</span><h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2><p class="lede" style="margin:0 auto">{{ section.settings.subheading | escape }}</p></div></div><div class="tiers" role="list">
{% for block in section.blocks %}{%- liquid
  assign total_price = 0
  assign total_compare_at_price = 0
  assign unavailable = false
  for product in block.settings.products
    assign variant = product.selected_or_first_available_variant
    assign total_price = total_price | plus: variant.price
    if variant.compare_at_price > variant.price
      assign total_compare_at_price = total_compare_at_price | plus: variant.compare_at_price
    else
      assign total_compare_at_price = total_compare_at_price | plus: variant.price
    endif
    unless product.available
      assign unavailable = true
    endunless
  endfor
-%}<article class="glass tier{% if block.settings.featured %} best{% endif %} rv" role="listitem" {{ block.shopify_attributes }}><span class="tag">{{ block.settings.tag | escape }}</span><div class="tierpix{% if block.settings.products.count > 4 %} five{% endif %}" aria-hidden="true">{% for product in block.settings.products limit: 5 %}{% if product.featured_image %}{{ product.featured_image | image_url: width: 180 | image_tag: class: 'shop-pimg', loading: 'lazy', alt: product.title }}{% endif %}{% endfor %}</div><div class="qty">{{ block.settings.products.count }}<small>Products</small></div><div class="price">{{ total_price | money }}{% if total_compare_at_price > total_price %} <s>{{ total_compare_at_price | money }}</s>{% endif %}</div><p class="body-s" style="font-size:12px">{{ block.settings.price_note | escape }}</p><ul>{% if block.settings.feature_one != blank %}<li>{% render 'purelane-check-icon' %}{{ block.settings.feature_one | escape }}</li>{% endif %}{% if block.settings.feature_two != blank %}<li>{% render 'purelane-check-icon' %}{{ block.settings.feature_two | escape }}</li>{% endif %}{% if block.settings.feature_three != blank %}<li>{% render 'purelane-check-icon' %}{{ block.settings.feature_three | escape }}</li>{% endif %}</ul><form method="post" action="{{ routes.cart_add_url }}">{% for product in block.settings.products %}<input type="hidden" name="items[][id]" value="{{ product.selected_or_first_available_variant.id }}">{% endfor %}<input type="hidden" name="attributes[purelane_bundle]" value="{{ block.settings.tag | escape }}"><button type="submit" class="btn {% if block.settings.featured %}btn-primary{% else %}btn-ghost{% endif %}" {% if block.settings.products == blank or unavailable %}disabled{% endif %}>{% if unavailable %}Unavailable{% else %}{{ block.settings.button_label | escape }}{% endif %}</button></form></article>{% endfor %}
</div></div></section>
{% schema %}
{"name":"Purelane bundles","tag":"section","class":"purelane-bundles-section","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"Build your bundle"},{"type":"text","id":"heading","label":"Heading","default":"One box. Every room."},{"type":"textarea","id":"subheading","label":"Subheading","default":"Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."}],"blocks":[{"type":"bundle","name":"Bundle tier","settings":[{"type":"text","id":"tag","label":"Tag","default":"Starter"},{"type":"product_list","id":"products","label":"Products","limit":5},{"type":"text","id":"price_note","label":"Price note","default":"Add selected products to your cart"},{"type":"text","id":"feature_one","label":"Feature one","default":"Pick products for your home"},{"type":"text","id":"feature_two","label":"Feature two","default":"Free shipping across India"},{"type":"text","id":"feature_three","label":"Feature three"},{"type":"text","id":"button_label","label":"Button label","default":"Add bundle to cart"},{"type":"checkbox","id":"featured","label":"Featured","default":false}]}],"presets":[{"name":"Purelane bundles","blocks":[{"type":"bundle","settings":{"tag":"Starter"}},{"type":"bundle","settings":{"tag":"Most popular","featured":true}},{"type":"bundle","settings":{"tag":"Whole home"}}]}]}
{% endschema %}
