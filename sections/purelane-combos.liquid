<section class="sec purelane-combos" id="combos" data-scene="2">
  <div class="wrap">
    <div class="panel-head rv"><span class="kicker">{{ section.settings.kicker | escape }}</span><h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2><div class="rule" aria-hidden="true"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div><p class="lede" style="margin:14px auto 0">{{ section.settings.subheading | escape }}</p></div>
    <div class="comborail rv" role="list">
      {% for block in section.blocks %}
        <article class="glass combo{% if block.settings.featured %} hero-combo{% endif %}" role="listitem" {{ block.shopify_attributes }}>
          <div class="tray"><span class="save">{{ block.settings.top_label | escape }}</span>{% if block.settings.badge != blank %}<span class="flag">{{ block.settings.badge | escape }}</span>{% endif %}<div class="stack">
            {% for product in block.settings.products limit: 5 %}<span class="it">{% if product.featured_image %}{{ product.featured_image | image_url: width: 220 | image_tag: class: 'shop-pimg', loading: 'lazy', alt: product.title }}{% else %}<span class="tile">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</span>{% endif %}<span>{{ product.title | truncate: 28 | escape }}</span></span>{% unless forloop.last %}<span class="plus" aria-hidden="true">+</span>{% endunless %}{% endfor %}
          </div></div>
          <div class="body"><h3>{{ block.settings.title | escape }}</h3><div class="cnt">{{ block.settings.count_label | escape }}</div><p class="inc">{{ block.settings.description | escape }}</p><div class="prow"><strong>{{ block.settings.price | escape }}</strong>{% if block.settings.compare_at != blank %}<s>{{ block.settings.compare_at | escape }}</s>{% endif %}{% if block.settings.save_note != blank %}<em>{{ block.settings.save_note | escape }}</em>{% endif %}</div><div class="fine">{{ block.settings.fine_print | escape }}</div>
            <a class="btn {% if block.settings.featured %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#bundles' }}">{{ block.settings.button_label | escape }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a>
          </div>
        </article>
      {% endfor %}
    </div>
    <p class="railnote">{{ section.settings.railnote | escape }}</p>
  </div>
</section>

{% schema %}
{"name":"Purelane combos","tag":"section","class":"purelane-combos-section","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"Pre-built to save you money"},{"type":"text","id":"heading","label":"Heading","default":"Best selling combos"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."},{"type":"text","id":"railnote","label":"Rail note","default":"Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay."}],"blocks":[{"type":"combo","name":"Combo","settings":[{"type":"text","id":"title","label":"Title","default":"Kitchen essentials"},{"type":"product_list","id":"products","label":"Included products (visual stack)","limit":5},{"type":"text","id":"count_label","label":"Product count label","default":"3 products"},{"type":"textarea","id":"description","label":"Description","default":"A ready-made combination for the room you use most."},{"type":"header","content":"Offer pricing"},{"type":"text","id":"price","label":"Price","default":"₹499","info":"Marketing offer price shown on the card. No native single-product field exists for a combo offer, so this is an editable value."},{"type":"text","id":"compare_at","label":"Compare-at price","default":"₹897"},{"type":"text","id":"save_note","label":"Saving note (price row)","default":"Save ₹398"},{"type":"text","id":"top_label","label":"Saving badge (top)","default":"You save ₹398"},{"type":"text","id":"badge","label":"Flag badge"},{"type":"text","id":"fine_print","label":"Fine print","default":"Inclusive of all taxes · COD available"},{"type":"header","content":"Call to action"},{"type":"text","id":"button_label","label":"Button label","default":"Shop bundle"},{"type":"text","id":"button_link","label":"Button link","default":"#bundles","info":"On-page anchor (e.g. #bundles) or a URL."},{"type":"checkbox","id":"featured","label":"Featured","default":false}]}],"presets":[{"name":"Purelane combos","blocks":[{"type":"combo","settings":{"title":"Kitchen essentials","featured":true}},{"type":"combo","settings":{"title":"Laundry care bundle"}},{"type":"combo","settings":{"title":"Bathroom deep clean"}}]}]}
{% endschema %}
